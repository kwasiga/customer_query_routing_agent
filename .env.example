# VectorAI DB connection (defaults work when running via docker-compose)
ACTIAN_VECTORAI_URL=localhost:6574
ACTIAN_VECTORAI_REST_URL=http://localhost:6573

# Local LLM (GGUF model, run via llama-cpp-python)
# Defaults download a ~4.4GB quantized Mistral 7B Instruct model to ./models on first run
LLM_REPO_ID=TheBloke/Mistral-7B-Instruct-v0.2-GGUF
LLM_FILENAME=mistral-7b-instruct-v0.2.Q4_K_M.gguf
LLM_MODEL_DIR=models
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
# -1 = offload all layers to GPU (Metal on macOS); set to 0 to force CPU-only
LLM_N_GPU_LAYERS=-1

# Triage — minimum top context-doc similarity score required to auto-resolve
RESOLUTION_CONFIDENCE_THRESHOLD=0.55

